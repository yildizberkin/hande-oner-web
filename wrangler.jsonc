{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "hande-oner-web",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-18",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hande-oner-cms",
			"database_id": "eb19700e-0466-4900-ab96-d251c37e9fdf"
		}
	]
}